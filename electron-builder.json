{
  "appId": "com.vektra.hermesstudio",
  "productName": "Hermes Studio",
  "directories": {
    "output": "dist"
  },
  "files": [
    "desktop/**",
    "resources/icon.png"
  ],
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "resources/icon.png",
    "category": "AudioVideo",
    "artifactName": "Hermes-Studio-${version}.${ext}",
    "extraResources": [
      {
        "from": "build/engine",
        "to": "engine"
      }
    ]
  },
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "resources/icon.png",
    "extraResources": [
      {
        "from": "build/engine",
        "to": "engine"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Hermes Studio",
    "artifactName": "Hermes-Studio-Setup-${version}.${ext}"
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "icon": "resources/icon.png",
    "category": "public.app-category.video"
  }
}
